<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NumberPadButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:layout_margin">2dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/m3_outline_variant</item>
        <item name="backgroundTint">@color/m3_surface_container</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>
</resources>
