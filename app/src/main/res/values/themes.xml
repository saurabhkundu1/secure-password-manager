<resources>
    <!-- Base application theme -->
    <style name="Theme.SecurePass" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (Default Teal) -->
        <item name="colorPrimary">@color/palette_teal_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">#FFB300</item>
        <item name="colorOnSecondary">#000000</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/palette_teal_variant</item>
        <!-- Overall background -->
        <item name="android:windowBackground">?android:attr/windowBackground</item>
    </style>

    <!-- Palette themes -->
    <style name="Theme.SecurePass.Teal" parent="Theme.SecurePass" />

    <style name="Theme.SecurePass.Blue" parent="Theme.SecurePass">
        <item name="colorPrimary">@color/palette_blue_primary</item>
        <item name="android:statusBarColor">@color/palette_blue_variant</item>
    </style>

    <style name="Theme.SecurePass.Green" parent="Theme.SecurePass">
        <item name="colorPrimary">@color/palette_green_primary</item>
        <item name="android:statusBarColor">@color/palette_green_variant</item>
    </style>

    <style name="Theme.SecurePass.Purple" parent="Theme.SecurePass">
        <item name="colorPrimary">@color/palette_purple_primary</item>
        <item name="android:statusBarColor">@color/palette_purple_variant</item>
    </style>

    <style name="Theme.SecurePass.Red" parent="Theme.SecurePass">
        <item name="colorPrimary">@color/palette_red_primary</item>
        <item name="android:statusBarColor">@color/palette_red_variant</item>
    </style>
</resources>