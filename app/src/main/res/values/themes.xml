<resources>
    <!-- Base application theme -->
    <style name="Theme.SecurePass" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (Default Teal) -->
        <item name="colorPrimary">@color/palette_teal_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">#FFB300</item>
        <item name="colorOnSecondary">#000000</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/palette_teal_variant</item>
        <!-- Overall background -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Palette themes -->
    <style name="Theme.SecurePass.Teal" parent="Theme.SecurePass" />

    <style name="Theme.SecurePass.Blue" parent="Theme.SecurePass">
