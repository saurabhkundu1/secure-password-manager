<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="20dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:fitsSystemWindows="true">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/classic_blue"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Secure Pass"
        android:layout_marginBottom="8dp"/>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure Pass"
        android:textSize="24sp"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <!-- Instruction Text (changes based on setup/unlock) -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 6-digit code"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp"/>

    <!-- 6-dot PIN display -->
    <LinearLayout
        android:id="@+id/pinDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
    </LinearLayout>

    <!-- Number Pad in a GridLayout (3 columns x 5 rows) -->
    <GridLayout
        android:id="@+id/gridNumberPad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="5"
        android:gravity="center">

        <!-- Row 1 -->
        <Button android:id="@+id/btnKey0" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey1" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey2" style="@style/NumberPadButton"/>

        <!-- Row 2 -->
        <Button android:id="@+id/btnKey3" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey4" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey5" style="@style/NumberPadButton"/>

        <!-- Row 3 -->
        <Button android:id="@+id/btnKey6" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey7" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey8" style="@style/NumberPadButton"/>

        <!-- Row 4 -->
        <Button android:id="@+id/btnKey9" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey10" style="@style/NumberPadButton"/>
        <Button android:id="@+id/btnKey11" style="@style/NumberPadButton"/>

        <!-- Row 5: Delete, Biometric (center), Submit -->
        <Button android:id="@+id/btnDelete" style="@style/NumberPadButton" android:text="⌫"
            android:textColor="#D32F2F"/>
        <ImageButton
            android:id="@+id/btnBiometric"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_dialog_info"
            android:contentDescription="Biometric Unlock"
            android:scaleType="fitCenter"
            app:tint="?attr/colorPrimary"
            android:visibility="invisible"/>
        <Button android:id="@+id/btnSubmit" style="@style/NumberPadButton" android:text="✓"
            android:textColor="?attr/colorPrimary"/>
    </GridLayout>

    <!-- Error message (hidden by default) -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wrong code. Try again."
        android:textSize="14sp"
        android:textColor="#D32F2F"
        android:visibility="gone"
        android:layout_marginTop="12dp"/>

</LinearLayout>
