<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/teal_700"
        app:titleTextColor="@color/white"
        app:title="Settings"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationContentDescription="Back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fingerprint unlock"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLastCodeTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Last code entry: Never"
            android:textSize="14sp"
            android:textColor="#757575"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnChangeCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Master Code"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/teal_700"/>

        <Button
            android:id="@+id/btnLockVault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lock Vault Now"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#D32F2F"/>

    </LinearLayout>
</LinearLayout>